# Origem pública servida pelo Next e usada pelo navegador (proxy /api/** -> Nest).
APP_ORIGIN=http://localhost:3000
# Opcional; padrão = APP_ORIGIN. Configure para a URL pública do Next em produção.
# BETTER_AUTH_URL=https://fila.exemplo.com
# Gere um segredo aleatório de pelo menos 32 caracteres. Nunca versione o valor real.
BETTER_AUTH_SECRET=
# Caminho estável relativo ao diretório apps/api; padrão: apps/api/data/testafila.sqlite
# DATABASE_PATH=./data/testafila.sqlite
HOST=127.0.0.1
PORT=3001
NODE_ENV=development
